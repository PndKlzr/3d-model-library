{
  "name": "model-library",
  "productName": "3D Model Library",
  "version": "0.1.0-beta.2",
  "description": "A local-first Windows desktop app for browsing and organizing 3D-printing libraries.",
  "author": "PndKlzr",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite --host 127.0.0.1 --strictPort",
    "electron:dev": "node scripts/electron-dev.cjs",
    "build": "tsc -p tsconfig.node.json && node scripts/copy-preload.cjs && vite build",
    "package:windows": "npm run build && electron-forge package --platform win32 --arch x64",
    "make:windows": "npm run build && electron-forge make --platform win32 --arch x64",
    "verify:package": "node scripts/verify-package.mjs",
    "benchmark:thumbnails": "node scripts/thumbnail-benchmark.cjs",
    "probe:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/native-drop-probe/build.ps1",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^10.0.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
